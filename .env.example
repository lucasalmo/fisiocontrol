# String de conexão do Neon PostgreSQL (Console Neon → Connect → Connection string).
# Formato: postgresql://USUARIO:SENHA@HOST.neon.tech/BANCO?sslmode=require
# Use somente no servidor. Nunca prefixe com NEXT_PUBLIC_.
DATABASE_URL=

# Autenticação (obrigatória em produção).
# APP_PASSWORD: senha de acesso à aplicação.
# SESSION_SECRET: segredo aleatório com 32+ caracteres para assinar o cookie de sessão.
#   Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=
SESSION_SECRET=

# Somente para testes automatizados: banco DESCARTÁVEL (o schema public é recriado).
# TEST_DATABASE_URL=
